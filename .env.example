# Copy this to .env and fill in only the providers you want to use.

APP_ENV=development
LOG_LEVEL=INFO

# CoinAPI market data.
COINAPI_KEY=
COINAPI_BASE_URL=https://rest.coinapi.io

# Comma-separated CCXT exchange ids. These names must exist in ccxt.
EXCHANGE_IDS=binance,kraken,kucoin
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_COINAPI_SYMBOL_ID=BINANCE_SPOT_BTC_USDT

# Keep this true while testing. Live trading requires both:
# PAPER_TRADING=false and ENABLE_LIVE_TRADING=true, plus request confirmation.
PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
SANDBOX_MODE=true
KILL_SWITCH_ENABLED=false

# Basic risk limits.
MAX_ORDER_USD=25
MIN_ORDER_USD=5
MAX_DAILY_LOSS_USD=100
MAX_SLIPPAGE_PCT=0.50
MIN_ARBITRAGE_PROFIT_PCT=0.35
FEE_BUFFER_PCT=0.10

# Local SQL-backed order audit store.
DATABASE_URL=
# SQL Server example:
# DATABASE_URL=mssql+pyodbc://localhost/trading_bot?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&trusted_connection=yes
ORDER_DATABASE_PATH=data/trading_bot.sqlite3

# Optional CCXT credentials as JSON. Leave blank for public market data only.
# Example:
# EXCHANGE_API_KEYS_JSON={"binance":{"apiKey":"xxx","secret":"yyy"},"kraken":{"apiKey":"xxx","secret":"yyy","password":"optional"}}
EXCHANGE_API_KEYS_JSON={}

